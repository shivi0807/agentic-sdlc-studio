# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
PORT=8080
DEMO_AUTH_ENABLED=true

# Local persistence only. The data directory must not contain production data.
DATABASE_PATH=data/agentic_sdlc.db
# Generated projects stay under this application-owned root.
WORKSPACE_ROOT=workspaces

# The deterministic provider works offline. Change to ollama for a local open
# model, or gemini for Google's limited free API tier.
AGENT_PROVIDER=deterministic
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Optional Gemini Developer API provider. Keep the key in .env locally or a
# secret manager in cloud deployments; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Cloud Run cannot use localhost to reach your computer. Use deterministic mode
# or the optional Gemini provider in a cloud demonstration. Production still
# requires durable storage and production authentication.

LOG_LEVEL=INFO
